#include <physical_layouts.dtsi>

/ {
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <6>;
        // Maps the visual layout grid cleanly into a flat 6-column array
        map = <
            RC(0,0) RC(0,1) RC(0,2) // Physical Row 1: Col 1, Col 2, Col 3
            RC(0,3) RC(0,4) RC(0,5) // Physical Row 2: Col 1, Col 2, Col 3
        >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "3x2 Macropad";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        
        // Coordinates for the ZMK Studio graphical grid interface
        // 100 centi-units = 1 standard key unit (1u) width/height
        keys = <
            /* Visual Row 1 */
            <&key_physical_attrs 100 100    0    0 0 0 0>
            , <&key_physical_attrs 100 100 100    0 0 0 0>
            , <&key_physical_attrs 100 100 200    0 0 0 0>
            /* Visual Row 2 */
            , <&key_physical_attrs 100 100    0 100 0 0 0>
            , <&key_physical_attrs 100 100 100 100 0 0 0>
            , <&key_physical_attrs 100 100 200 100 0 0 0>
        >;
    };
};
