#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h> // Enables the mouse coordinate macros

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Mapping for the 6 direct inputs
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &studio_unlock
            >;

            // Encoder rotation emulates mouse vertical wheel scroll using relative positioning
            // Positive value (15) scrolls down, Negative value (-15) scrolls up
            sensor-bindings = <&inc_dec_kp MOVE_Y(15) MOVE_Y(-15)>;
        };
    };
};
