#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "rotary_xy_2x3-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    // 1. CRITICAL MATRIX FIX: Defines a 2-Row by 3-Column matrix map for ZMK Studio
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <2>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) // Row 0 (Top Row): Keys 1, 2, 3
            RC(1,0) RC(1,1) RC(1,2) // Row 1 (Bottom Row): Keys 4, 5, 6
        >;
    };

    // 2. Direct pin layout mapped cleanly to Row 0 and Row 1 matrix addresses
    kscan0: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&pro_micro  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 0, Col 0 (Key 1)
            , <&pro_micro  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 0, Col 1 (Key 2)
            , <&pro_micro  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 0, Col 2 (Key 3)
            , <&pro_micro  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1, Col 0 (Key 4)
            , <&pro_micro  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1, Col 1 (Key 5)
            , <&pro_micro  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1, Col 2 (Key 6)
            ;
    };

    // 3. ROTARY ENCODER HARDWARE MAPPING
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; 
        b-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; 
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};

