// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more
// instructions.

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include "rotary_xy_2x3-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        debounce-period-ms = <5>;

        // MAP EACH PHYSICAL KEY DIRECTLY TO A PRO MICRO PIN
        // Grounding a pin will trigger the corresponding key press
        input-gpios
            = <&pro_micro  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 1 (Top Left)
            , <&pro_micro  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 2 (Top Mid)
            , <&pro_micro  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 3 (Top Right)
            , <&pro_micro  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 4 (Bottom Left)
            , <&pro_micro  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 5 (Bottom Mid)
            , <&pro_micro  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 6 (Bottom Right)
            ;
    };

    // 1. ROTARY ENCODER CONFIGURATION
    encoder: encoder {
        compatible = "alps,ec11";
        // Connect the encoder's single pin A and pin B to these Pro Micro pins
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };

    // 2. CHOOSE YOUR RELEVANT ANALOG INPUTS
    joystick: analog_axis {
        compatible = "analog-axis";
        poll-period-ms = <10>; // 10ms sampling rate for smooth movement
        
        x_axis {
            zephyr,axis = <INPUT_REL_X>;
            io-channels = <&adc 1>; // Pro Micro A1 pin (A0, A1, A2, A3 are valid ADC channels)
            out-min = <(-30)>;     // Max cursor speed to the left
            out-max = <30>;       // Max cursor speed to the right
            deadzone = <12>;      // Prevents drifting when untouched
        };

        y_axis {
            zephyr,axis = <INPUT_REL_Y>;
            io-channels = <&adc 2>; // Pro Micro A2 pin
            out-min = <(-30)>;     // Max cursor speed upward
            out-max = <30>;       // Max cursor speed downward
            deadzone = <12>;      // Prevents drifting when untouched
        };
    };

    // 3. TRANSLATE SIGNALS INTO LIVE MOUSE DATA
    joystick_listener: joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;
    };

    // 4. ENABLE THE INTERNAL VOLTAGE CHANNELS ON THE Microcontroller
    &adc {
        status = "okay";
    };
};

