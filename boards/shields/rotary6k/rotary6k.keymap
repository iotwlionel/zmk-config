#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h> // Enables SCRL_UP and SCRL_DN constants

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Mapping for the 6 direct inputs
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &studio_unlock
            >;

            // Use standard &inc_dec_kp directly with pointing definitions
            sensor-bindings = <&inc_dec_kp SCRL_UP SCRL_DN>;
        };
    };
};
