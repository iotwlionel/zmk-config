#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h> // Modern pointing device binding header

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &studio_unlock
            >;

            // Modern mouse scroll configuration using the correct sensor binding macro
            sensor-bindings = <&inc_dec_msc SCRL_UP SCRL_DN>;
        };
    };
};
