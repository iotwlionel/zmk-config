#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // 1. MACRO TO COMBINE LAYER 1 AND SHIFT ON HOLD
        mo_shift: mo_shift_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LSHIFT &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_release &kp LSHIFT &mo MACRO_PLACEHOLDER>
                ;
        };

        // 2. HOLD-TAP ASSIGNMENT FOR KEY 6
        studio_mo: studio_momentary_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>; 
            bindings = <&mo_shift>, <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: The Base Layer
        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q      &kp W      &kp E      
                &kp A      &kp S      &studio_mo 1 0 // Hold for Layer 1 + Shift, Tap to Unlock Studio!
            >;

            // Encoder Default: Scrolls pages up and down
            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        // LAYER 1: Mouse Movement Layer (Active when Key 6 is held)
        mouse_movement_layer {
            display-name = "Mouse";
            bindings = <
                &trans     &trans     &trans     
                &trans     &trans     &trans 
            >;

            // FIX: Encoder now moves your computer mouse cursor Left and Right!
            sensor-bindings = <&inc_dec_kp MOVE_LEFT MOVE_RIGHT>;
        };
    };
};
