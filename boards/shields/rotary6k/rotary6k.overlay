#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi> // <-- Required to use the &key_physical_attrs macro

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    // 1. Direct GPIO Pin Input Scan Configuration
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 1
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 2
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 3
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 4
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 5
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 6
            ;
    };

    // 2. Hardware Encoder Configuration
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <80>; 
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>; 
    };

    // 3. Physical Layout required by ZMK Studio (with structural dimensions)
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        
        // Map 6 physical keys in a single straight row for ZMK Studio rendering
        // Parameters format: <width height X-offset Y-offset rotation rotation-X rotation-Y>
        keys 
            = <&key_physical_attrs 100 100    0   0 0 0 0> // Key 1 (X=0)
            , <&key_physical_attrs 100 100  100   0 0 0 0> // Key 2 (X=1U)
            , <&key_physical_attrs 100 100  200   0 0 0 0> // Key 3 (X=2U)
            , <&key_physical_attrs 100 100  300   0 0 0 0> // Key 4 (X=3U)
            , <&key_physical_attrs 100 100  400   0 0 0 0> // Key 5 (X=4U)
            , <&key_physical_attrs 100 100  500   0 0 0 0> // Key 6 (X=5U)
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
        >;
    };
};
