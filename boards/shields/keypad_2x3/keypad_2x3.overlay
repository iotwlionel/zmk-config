/ {
    chosen {
        // ZMK Studio requires mapping hardware via physical layouts rather than simple transforms
        zmk,physical-layout = &layout_main;
    };

    kscan0: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
            = <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1, Col 1
            , <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1, Col 2
            , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1, Col 3
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 2, Col 1
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 2, Col 2
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // Row 2, Col 3
    };

    // Defines the physical X/Y grid positions (in centi-units) so keys render properly in ZMK Studio
    layout_main: layout_main {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = &kscan0;
        keys = <
            /* Row 1: X-coords: 0, 100, 200 | Y-coord: 0 */
            <&key_physical_attrs 100 100    0    0 0 0 0>
            ,&<&key_physical_attrs 100 100 100    0 0 0 0>
            ,&<&key_physical_attrs 100 100 200    0 0 0 0>
            /* Row 2: X-coords: 0, 100, 200 | Y-coord: 100 */
            ,&<&key_physical_attrs 100 100    0 100 0 0 0>
            ,&<&key_physical_attrs 100 100 100 100 0 0 0>
            ,&<&key_physical_attrs 100 100 200 100 0 0 0>
        ];
    };
};
