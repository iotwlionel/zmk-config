// This file utilizes natively linked ZMK kscan drivers to avoid linker crashes.
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include "rotary_xy_2x3-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,physical-layout = &physical_layout0;
    };

    // Formats your 6 physical buttons into an addressable sequence for ZMK Studio
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
        >;
    };

    // Composite manager grouping your direct keys safely
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <1>;
        columns = <6>;

        // Links your 6 digital direct pins straight to matrix cells
        buttons {
            kscan = <&kscan_direct>;
        };
    };

    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&pro_micro  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 1
            , <&pro_micro  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 2
            , <&pro_micro  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 3
            , <&pro_micro  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 4
            , <&pro_micro  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 5
            , <&pro_micro  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 6
            ;
    };

    // ROTARY ENCODER HARDWARE MAPPING
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};
