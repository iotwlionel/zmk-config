// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev for more
// instructions.

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "rotary_xy_2x3-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    // A default transform block is required to map your 6 keys cleanly
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
        >;
    };

    kscan0: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        // MAP EACH PHYSICAL KEY DIRECTLY TO A PRO MICRO PIN
        // Debounce is inherited via the GPIO layout layer rather than a text key string here
        input-gpios
            = <&pro_micro  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 1
            , <&pro_micro  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 2
            , <&pro_micro  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 3
            , <&pro_micro  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 4
            , <&pro_micro  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 5
            , <&pro_micro  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Key 6
            ;
    };

    // 1. ROTARY ENCODER CONFIGURATION
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };

    // 2. CHOOSE YOUR RELEVANT ANALOG INPUTS
    joystick: analog_axis {
        compatible = "analog-axis";
        poll-period-ms = <10>; // 10ms sampling rate for smooth movement
        
        axis_x {
            zephyr,axis = <INPUT_REL_X>;
            io-channels = <&adc 1>; // Pro Micro A1 pin
            out-min = <(-30)>;     
            out-max = <30>;       
            deadzone = <12>;      
        };

        axis_y {
            zephyr,axis = <INPUT_REL_Y>;
            io-channels = <&adc 2>; // Pro Micro A2 pin
            out-min = <(-30)>;     
            out-max = <30>;       
            deadzone = <12>;      
        };
    };

    // 3. TRANSLATE SIGNALS INTO LIVE MOUSE DATA
    joystick_listener: joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;
    };
}; 

// 4. ENABLE THE INTERNAL VOLTAGE CHANNELS (Lives safely outside the root block)
&adc {
    status = "okay";
};
