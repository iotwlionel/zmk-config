#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h> // Keep this for mouse scroll targets

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &studio_unlock
            >;

            // Use &inc_dec_kp to correctly parse SCRL_UP and SCRL_DN parameters
            sensor-bindings = <&inc_dec_kp SCRL_UP SCRL_DN>;
        };
    };
};
